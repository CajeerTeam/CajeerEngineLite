#!/usr/bin/env php
<?php
declare(strict_types=1);
require dirname(__DIR__).'/bootstrap.php';
use CajeerEngine\Lite;
use CajeerEngine\Update\{UpdatePackage,UpdateEngine,AutomaticUpdates,ControlCenter,Scheduler};
use CajeerEngine\Security\SecurityAudit;
use CajeerEngine\AI\{OpenAIClient,UsageLimiter,SupportDiagnostics,Acceptance,ProductionAIAcceptance};
use CajeerEngine\Auth\{RecoveryService,AuthAcceptance,StableAcceptance};
use CajeerEngine\Analytics\{ReportService,ReportCache,HttpClient};
use CajeerEngine\Modules\ModuleConfig;
use CajeerEngine\Developer\DeveloperDiagnostics;
use CajeerEngine\Operations\CmsOperations;
use CajeerEngine\Integrations\{IntegrationDiagnostics,ProductionAcceptance};
use CajeerEngine\Release\StableCMSAcceptance;
use CajeerEngine\Compatibility\CompatibilityAssurance;
$app=new Lite(dirname(__DIR__));
try {
    $cmd = $argv[1] ?? 'help';
    switch ($cmd) {
        case 'monitor':
            $action=$argv[2]??'';$minutes=60;$verify=false;$seen=[];
            if (!in_array($action,['check','status'],true)) throw new InvalidArgumentException('Usage: monitor check|status [--minutes=60] [--verify-backup]');
            foreach (array_slice($argv,3) as $arg) {
                if (preg_match('/^--minutes=([0-9]{1,4})$/D',$arg,$m)&&!isset($seen['minutes'])) {$minutes=(int)$m[1];$seen['minutes']=true;}
                elseif ($arg==='--verify-backup'&&$action==='check'&&!$verify) $verify=true;
                elseif ($arg==='--json'&&!isset($seen['json'])) $seen['json']=true;
                else throw new InvalidArgumentException('Invalid monitor option');
            }
            if ($minutes<1||$minutes>1440) throw new InvalidArgumentException('Window must be 1–1440 minutes');
            $report=$action==='check'?\CajeerEngine\Monitoring\OperationalHealth::run($app->root,$minutes,$verify):\CajeerEngine\Monitoring\RequestLog::report($app->root,$minutes);
            echo json_encode($report,JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";
            if ($action==='check'&&!$report['ok']) exit(1);
            break;
        case 'compatibility':
            $action=$argv[2]??'';
            if ($action==='check' && (count($argv)===3 || (count($argv)===4 && $argv[3]==='--json'))) {
                $report=CompatibilityAssurance::check($app->root);
                if (($argv[3]??'')==='--json') {
                    echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
                } else {
                    foreach($report['checks'] as $check) echo strtoupper($check['status']).' '.$check['id'].': '.$check['detail']."\n";
                }
                if (!$report['ok']) exit(1);
            } elseif($action==='migration' && count($argv)===4 && $argv[3]==='preview') {
                echo json_encode(CompatibilityAssurance::preview($app->root),JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";
            } elseif($action==='migration' && count($argv)===4 && $argv[3]==='apply') {
                echo json_encode(CompatibilityAssurance::apply($app->root),JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";
            } else throw new InvalidArgumentException('Usage: compatibility check [--json] | compatibility migration preview|apply');
            break;
        case 'update':
            $engine=new UpdateEngine($app->root);
            $action=$argv[2]??'';
            if($action==='trust' && count($argv)===4 && $argv[3]==='status') {
                $report=\CajeerEngine\Update\TrustPolicy::configured()->report();
            } elseif($action==='monitor' && count($argv)===4 && in_array($argv[3],['status','check'],true)) {
                $report=(new ControlCenter($app->root))->status()['monitoring'];
                if($argv[3]==='check'&&!$report['ok']){echo json_encode($report,JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";exit(1);}
            } elseif($action==='snapshots' && count($argv)>=4 && count($argv)<=6 && in_array($argv[3],['status','prune'],true)) {
                $keep=3;$days=7;$seen=[];
                foreach(array_slice($argv,4) as $arg){
                    if(!preg_match('/^--(keep|days)=([1-9][0-9]{0,3})$/D',$arg,$m)||isset($seen[$m[1]]))throw new InvalidArgumentException('Invalid snapshot retention option');
                    $seen[$m[1]]=true;if($m[1]==='keep')$keep=(int)$m[2];else $days=(int)$m[2];
                }
                $report=$engine->snapshots($keep,$days,$argv[3]==='prune');
                if(!$report['ok']){echo json_encode($report,JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";exit(1);}
            } elseif($action==='control' && count($argv)===4) {
                $control=new ControlCenter($app->root);
                if($argv[3]==='status')$report=$control->status();
                elseif($argv[3]==='work')$report=$control->work();
                else throw new InvalidArgumentException('Usage: update control status|work');
            } elseif($action==='maintenance' && count($argv)===4) {
                $control=new ControlCenter($app->root);
                if($argv[3]==='plan'){echo $control->maintenancePlan()."\n";break;}
                elseif($argv[3]==='recover')$report=$control->maintenanceRecover();
                elseif($argv[3]==='verify')$report=$control->maintenanceVerify();
                else throw new InvalidArgumentException('Usage: update maintenance plan|recover|verify');
            } elseif($action==='scheduler' && count($argv)===4) {
                $scheduler=new Scheduler($app->root);
                if($argv[3]==='status')$report=$scheduler->status();
                elseif($argv[3]==='tick')$report=$scheduler->tick();
                else throw new InvalidArgumentException('Usage: update scheduler status|tick');
                if(($report['action']??null)==='recovery_required') {
                    echo json_encode($report,JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";exit(2);
                }
            } elseif($action==='auto') {
                $auto=new AutomaticUpdates($app->root);
                $sub=$argv[3]??'';
                if(count($argv)!==4)throw new InvalidArgumentException('Usage: update auto status|check|verify|run');
                if($sub==='status')$report=$auto->status();
                elseif($sub==='check')$report=$auto->check();
                elseif($sub==='verify')$report=$auto->verifiedCheck(\CajeerEngine\Update\ReleaseDiscovery::channel());
                elseif($sub==='run')$report=$auto->run();
                else throw new InvalidArgumentException('Usage: update auto status|check|verify|run');
            }
            elseif($action==='status' && count($argv)===3) $report=$engine->status();
            elseif($action==='verify' && count($argv)===4) $report=$engine->verify($argv[3]);
            elseif($action==='install' && count($argv)===4) $report=$engine->install($argv[3]);
            elseif($action==='recover' && count($argv)===3) $report=$engine->recover();
            elseif($action==='rollback' && count($argv)===4) $report=$engine->rollback($argv[3]);
            elseif($action==='package' && count($argv)===5) {
                $signing=getenv('CAJEER_UPDATE_SIGNING_KEY_FILE');
                if(!is_string($signing)||!str_starts_with($signing,'/')) throw new InvalidArgumentException('Set absolute CAJEER_UPDATE_SIGNING_KEY_FILE');
                $report=UpdatePackage::build($app->root,$argv[3],$argv[4],$signing);
            } else throw new InvalidArgumentException('Usage: update monitor status|monitor check|snapshots status|snapshots prune|trust status|status|control status|control work|scheduler status|scheduler tick|maintenance plan|maintenance recover|maintenance verify|auto status|auto check|auto verify|auto run|verify <package>|install <package>|recover|rollback <id>|package <candidate-dir> <output>');
            echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
            break;
        case 'security':
            if (($argv[2]??'')!=='audit' || count($argv)>4 ||
                (isset($argv[3]) && $argv[3]!=='--json')) {
                throw new InvalidArgumentException('Usage: security audit [--json]');
            }
            $report=SecurityAudit::run($app->root);
            if (($argv[3]??'')==='--json') {
                echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
            } else {
                foreach ($report['checks'] as $check) {
                    echo strtoupper($check['status']).' '.$check['id'].': '.$check['detail']."\n";
                }
                echo 'Dependency inventory: '.json_encode($report['dependency_inventory'],JSON_THROW_ON_ERROR)."\n";
            }
            if (!$report['ok']) exit(1);
            break;
        case 'operations':
            $ops=new CmsOperations($app->root);
            $action=$argv[2]??'';
            if ($action==='recover' && count($argv)===3) {
                echo $ops->recoverPending() ? "Interrupted CMS import rolled back.\n" : "No pending recovery.\n";
            } elseif ($action==='check' && count($argv)===3) {
                echo json_encode($ops->health(),JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR)."\n";
            } elseif ($action==='backup' && count($argv)>=4) {
                $sub=$argv[3];
                if ($sub==='create' && count($argv)===4) echo $ops->createBackup()."\n";
                elseif ($sub==='list' && count($argv)===4) foreach ($ops->names() as $name) echo $name."\n";
                elseif ($sub==='verify' && count($argv)===5) echo json_encode($ops->verifyBackup($argv[4]),JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";
                elseif ($sub==='restore' && count($argv)===5) {
                    if (getenv('CAJEER_OPERATIONS_CONFIRM')!==$argv[4]) throw new InvalidArgumentException('Confirm exact backup file name in CAJEER_OPERATIONS_CONFIRM');
                    $ops->restoreBackup($argv[4]);echo "CMS archive restored. Sessions revoked.\n";
                } else throw new InvalidArgumentException('Usage: operations backup create|list|verify <name>|restore <name>');
            } elseif ($action==='export' && count($argv)===4) {
                $ops->exportTo($argv[3]);echo "Portable export written.\n";
            } elseif ($action==='import' && count($argv)===4) {
                if (getenv('CAJEER_OPERATIONS_CONFIRM')!=='IMPORT') throw new InvalidArgumentException('Set CAJEER_OPERATIONS_CONFIRM=IMPORT');
                $ops->importFile($argv[3]);echo "Content and media imported; sessions revoked.\n";
            } elseif ($action==='audit' && count($argv)===3) {
                $report=$ops->auditStorage();
                echo json_encode($report,JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";
                if ($report['orphan_files']!==0) exit(1);
            } elseif ($action==='repair-orphans' && count($argv)===3) {
                if (getenv('CAJEER_OPERATIONS_CONFIRM')!=='REPAIR_ORPHANS') {
                    throw new InvalidArgumentException('Set CAJEER_OPERATIONS_CONFIRM=REPAIR_ORPHANS');
                }
                echo json_encode($ops->auditStorage(true),JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";
            } elseif ($action==='cache' && ($argv[3]??'')==='clear' && count($argv)===4) {
                echo 'Analytics cache files removed: '.$ops->clearAnalyticsCache()."\n";
            } elseif ($action==='prune' && count($argv)===4 && preg_match('/^(?:[1-9]|[1-9][0-9]|100)$/D',$argv[3])) {
                if (getenv('CAJEER_OPERATIONS_CONFIRM')!=='PRUNE') throw new InvalidArgumentException('Set CAJEER_OPERATIONS_CONFIRM=PRUNE');
                echo 'Backups removed: '.$ops->pruneBackups((int)$argv[3])."\n";
            } else throw new InvalidArgumentException('Usage: operations check|recover|audit|repair-orphans|backup create|backup list|backup verify <name>|backup restore <name>|export <absolute-file>|import <file>|cache clear|prune <keep>');
            break;
        case 'developer':
            if (($argv[2]??'')!=='check' || count($argv)>4 ||
                (isset($argv[3]) && $argv[3]!=='--json')) {
                throw new InvalidArgumentException('Usage: developer check [--json]');
            }
            $report=DeveloperDiagnostics::run($app->root,$app->load());
            if (($argv[3]??'')==='--json') {
                echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
            } else {
                foreach ($report['checks'] as $item) {
                    echo strtoupper($item['status']).' '.$item['id'].': '.$item['detail']."\n";
                }
                echo 'Developer diagnostics: '.($report['ok']?'PASS':'FAIL')."\n";
            }
            if (!$report['ok']) exit(1);
            break;
        case 'support':
            if (($argv[2]??'')!=='check' || count($argv)>4 ||
                (isset($argv[3]) && $argv[3]!=='--json')) {
                throw new InvalidArgumentException('Usage: support check [--json]');
            }
            $snapshot=SupportDiagnostics::collect($app->root,$app->load());
            if (($argv[3]??'')==='--json') {
                echo json_encode($snapshot,JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES)."\n";
            } else {
                foreach ($snapshot['checks'] as $id=>$status) echo strtoupper($status).' '.$id."\n";
                echo 'Totals: '.json_encode($snapshot['counts'],JSON_THROW_ON_ERROR)."\n";
            }
            if ($snapshot['counts']['fail']>0) exit(1);
            break;
        case 'ai':
            if (($argv[2]??'')==='release-check') {
                $options=array_slice($argv,3);
                if (count($options)>3 || count($options)!==count(array_unique($options)) ||
                    array_diff($options,['--json','--live','--paid'])) {
                    throw new InvalidArgumentException('Usage: ai release-check [--json] [--live] [--paid]');
                }
                $report=ProductionAIAcceptance::run($app->root,$app->load(),
                    in_array('--live',$options,true),in_array('--paid',$options,true));
                if (in_array('--json',$options,true)) {
                    echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
                } else {
                    foreach ($report['checks'] as $item) {
                        echo strtoupper($item['status']).' '.$item['id'].': '.$item['message']."\n";
                    }
                    foreach ($report['manual'] as $item) echo 'MANUAL '.$item."\n";
                }
                // Never turn a synthetic or read-only probe into production signoff.
                if (!$report['automated_ok']) exit(1);
                exit(2);
            }
            if (($argv[2]??'')==='acceptance') {
                $options=array_slice($argv,3);
                if (count($options)>2 || count($options)!==count(array_unique($options)) ||
                    array_diff($options,['--json','--live'])) {
                    throw new InvalidArgumentException('Usage: ai acceptance [--json] [--live]');
                }
                $report=Acceptance::run($app->root,$app->load(),in_array('--live',$options,true));
                if (in_array('--json',$options,true)) {
                    echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
                } else {
                    foreach ($report['checks'] as $item) echo strtoupper($item['status']).' '.$item['id'].': '.$item['message']."\n";
                    foreach ($report['manual'] as $item) echo 'MANUAL '.$item."\n";
                }
                // A healthy local release is not evidence of a successful paid end-to-end request.
                if (!$report['automated_ok']) exit(1);
                exit(2);
            }
            if (($argv[2]??'')!=='status' || count($argv)!==3) {
                throw new InvalidArgumentException('Usage: ai status | ai acceptance [--json] [--live] | ai release-check [--json] [--live] [--paid]');
            }
            $state=$app->load();
            $usage=(new UsageLimiter($app->root))->status();
            echo json_encode(['enabled'=>$state['ai']['enabled'],'model'=>$state['ai']['model'],
                'key_configured'=>OpenAIClient::configured(),'limits'=>$state['ai'],'usage'=>$usage],
                JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
            break;
        case 'install':
            $password=getenv('CAJEER_ADMIN_PASSWORD');
            if ($password===false) { fwrite(STDERR,"Admin password (input is visible): "); $password=rtrim((string)fgets(STDIN),"\r\n"); }
            $app->install($password,$argv[2]??'http://127.0.0.1:8080',$argv[3]??'Мой сайт');
            echo "Installed. /admin\n"; break;
        case 'doctor':
            if (version_compare(PHP_VERSION,'8.4.1','<')) throw new RuntimeException('PHP 8.4.1+ required');
            foreach (['json','filter','hash'] as $extension) if (!extension_loaded($extension)) throw new RuntimeException('Missing extension '.$extension);
            $state=$app->load();
            if (\CajeerEngine\Auth\OidcClient::enabled($state['settings']['url']) && !extension_loaded('openssl')) {
                throw new RuntimeException('SkiF4er ID requires the OpenSSL extension');
            }
            if ($state['ai']['enabled'] && (!extension_loaded('openssl') || !filter_var(ini_get('allow_url_fopen'),FILTER_VALIDATE_BOOLEAN))) {
                throw new RuntimeException('OpenAI requires OpenSSL and allow_url_fopen=On');
            }
            if (!is_writable(dirname($app->file()))) throw new RuntimeException('Storage not writable');
            $report=IntegrationDiagnostics::run($app->root, $state);
            if (!$report['ok']) throw new RuntimeException('Integration runtime diagnostics failed; run integrations check');
            echo "OK (Lite ".Lite::VERSION.", core baseline ".Lite::ENGINE_BASE_VERSION.", schema ".$state['schema'].")\n"; break;
        case 'integrations':
            if (($argv[2] ?? '') !== 'check' || count($argv) > 4 ||
                (count($argv) === 4 && $argv[3] !== '--json')) {
                throw new InvalidArgumentException('Usage: integrations check [--json]');
            }
            $report=IntegrationDiagnostics::run($app->root, $app->load());
            if (($argv[3] ?? '') === '--json') {
                echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n";
            } else {
                foreach ($report['checks'] as $check) {
                    echo strtoupper($check['status']).' '.$check['id'].': '.$check['message']."\n";
                }
                echo $report['ok'] ? "Integration diagnostics: OK\n" : "Integration diagnostics: FAILED\n";
            }
            if (!$report['ok']) exit(1);
            break;
        case 'release':
            if (in_array($argv[2]??'', ['production-check','sign-off'],true)) {
                $action=$argv[2];$dir=null;$evidence=null;$providers=[];$live=false;$paid=false;$seen=[];
                foreach (array_slice($argv,3) as $flag) {
                    if (isset($seen[$flag])) throw new InvalidArgumentException('Duplicate production option');
                    $seen[$flag]=true;
                    if ($flag==='--live') $live=true;
                    elseif ($flag==='--paid') $paid=true;
                    elseif ($flag==='--json') continue;
                    elseif (str_starts_with($flag,'--provider=')) $providers[]=substr($flag,11);
                    elseif (str_starts_with($flag,'--artifacts=')&&$dir===null) $dir=substr($flag,12);
                    elseif (str_starts_with($flag,'--evidence=')&&$evidence===null) $evidence=substr($flag,11);
                    else throw new InvalidArgumentException('Invalid production option');
                }
                $key=\CajeerEngine\Update\TrustPolicy::configured();
                if (!$dir||($action==='sign-off'&&(!$live||!$evidence||getenv('CAJEER_PRODUCTION_SIGNOFF_CONFIRM')!=='I_REVIEWED_PRODUCTION_EVIDENCE'))||($action==='production-check'&&$evidence!==null)) throw new InvalidArgumentException('Production gate needs --artifacts=DIR, pinned key; sign-off also needs --live, --evidence=DIR and confirmation');
                $site=(new \CajeerEngine\Storage\SiteRepository($app->root))->read();
                if ($site===null||$site['schema']!==\CajeerEngine\Storage\SiteState::SCHEMA) throw new RuntimeException('Install or explicitly migrate the site before production acceptance');
                $report=\CajeerEngine\Release\ProductionStable::run($app->root,$site,$dir,$key,$live,$providers,$paid);
                if ($action==='sign-off'&&$report['automated_ok']) {
                    $record=\CajeerEngine\Release\ProductionStable::signoff($app->root,$report,$evidence);
                    echo json_encode($record,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";exit(0);
                }
                echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
                exit($report['automated_ok']?2:1);
            }
            if (($argv[2]??'')==='rc-check') {
                $live=false;$paid=false;$providers=[];$seen=[];
                foreach (array_slice($argv,3) as $flag) {
                    if (isset($seen[$flag])) throw new InvalidArgumentException('Duplicate RC option');
                    $seen[$flag]=true;
                    if ($flag==='--live') $live=true;
                    elseif ($flag==='--paid') $paid=true;
                    elseif ($flag==='--json') continue;
                    elseif (str_starts_with($flag,'--provider=')) $providers[]=substr($flag,11);
                    else throw new InvalidArgumentException('Invalid RC option');
                }
                $report=\CajeerEngine\Release\ReleaseCandidate::run($app->root,$app->load(),$live,$providers,$paid);
                echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
                exit($report['automated_ok']?2:1);
            }
            if (($argv[2]??null)==='stable-check') {
                $flags=array_slice($argv,3);
                if (count($flags)>2 || count($flags)!==count(array_unique($flags)) ||
                    array_diff($flags,['--json','--live'])) {
                    throw new InvalidArgumentException('Usage: release stable-check [--json] [--live]');
                }
                $report=StableCMSAcceptance::run($app->root,$app->load(),in_array('--live',$flags,true));
                if (in_array('--json',$flags,true)) {
                    echo json_encode($report,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR)."\n";
                } else {
                    foreach ($report['checks'] as $item) {
                        echo strtoupper($item['status']).' '.$item['id'].': '.$item['message']."\n";
                    }
                    foreach ($report['manual'] as $item) echo 'MANUAL '.$item."\n";
                    echo 'CMS '.Lite::VERSION.' release readiness: '.strtoupper($report['status'])."\n";
                }
                if (!$report['automated_ok']) exit(1);
                // Local/live probes cannot sign off human deployment acceptance.
                exit(2);
            }
            if (($argv[2] ?? '') !== 'check' || count($argv) > 4 ||
                (count($argv) === 4 && $argv[3] !== '--json')) {
                throw new InvalidArgumentException('Usage: release check [--json]');
            }
            $report=ProductionAcceptance::run($app->root, $app->load());
            if (($argv[3] ?? '') === '--json') {
                echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n";
            } else {
                foreach ($report['checks'] as $check) {
                    echo strtoupper($check['status']).' '.$check['id'].': '.$check['message']."\n";
                }
                foreach ($report['manual'] as $step) echo 'MANUAL '.$step."\n";
                echo $report['ok'] ? "Automated production checks: PASS (external verification pending)\n" :
                    "Automated production checks: FAIL\n";
            }
            if (!$report['ok']) exit(1);
            break;
        case 'auth':
            $operation = $argv[2] ?? null;
            if ($operation === 'check') {
                if (count($argv) > 4 || (isset($argv[3]) && $argv[3] !== '--json')) {
                    throw new InvalidArgumentException('Usage: auth check [--json]');
                }
                $report = AuthAcceptance::run($app->root, $app->load());
                if (($argv[3] ?? null) === '--json') {
                    echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n";
                } else {
                    foreach ($report['checks'] as $check) {
                        echo strtoupper($check['status']).' '.$check['id'].': '.$check['message']."\n";
                    }
                    foreach ($report['manual'] as $step) echo 'MANUAL '.$step."\n";
                    echo $report['ok'] ? "Authentication local checks: PASS (live IdP acceptance pending)\n" :
                        "Authentication local checks: FAIL\n";
                }
                if (!$report['ok']) exit(1);
            } elseif ($operation === 'release-check') {
                $options = array_slice($argv,3);
                if (count($options) > 2 || count($options) !== count(array_unique($options)) ||
                    array_diff($options,['--json','--live'])) {
                    throw new InvalidArgumentException('Usage: auth release-check [--json] [--live]');
                }
                $report=StableAcceptance::run($app->root,$app->load(),in_array('--live',$options,true));
                if (in_array('--json',$options,true)) {
                    echo json_encode($report,JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n";
                } else {
                    foreach ($report['checks'] as $check) {
                        echo strtoupper($check['status']).' '.$check['id'].': '.$check['message']."\n";
                    }
                    foreach ($report['manual'] as $step) echo 'MANUAL '.$step."\n";
                    echo 'Release readiness: '.strtoupper($report['status'])."\n";
                }
                // Never use a successful exit code to imply live owner/Keycloak acceptance.
                if (!$report['automated_ok']) exit(1);
                if (!$report['production_accepted']) exit(2);
            } else {
                throw new InvalidArgumentException('Usage: auth check [--json] | auth release-check [--json] [--live]');
            }
            break;
        case 'analytics':
            $operation=$argv[2]??'';
            if (!in_array($operation,['refresh','status'],true) || count($argv)>4) {
                throw new InvalidArgumentException('Usage: analytics refresh|status [--days=7]');
            }
            $days=7;
            if (isset($argv[3])) {
                if (!preg_match('/^--days=(3|7|14|30|90)$/D',$argv[3])) {
                    throw new InvalidArgumentException('Allowed --days: 3,7,14,30,90');
                }
                $days=(int)substr($argv[3],7);
            }
            $state=$app->load();
            $cache=new ReportCache($app->root);
            if ($operation==='refresh') {
                $report=(new ReportService(new HttpClient(),$app->root))->collect($state,$days);
                $cache->save($state,$days,$report);
            } else $report=$cache->read($state,$days);
            echo json_encode($report??['status'=>'no_cache'],JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
            break;
        case 'migrate':
            echo $app->migrate() ? "Migrated site to schema ".\CajeerEngine\Storage\SiteState::SCHEMA." (backup saved).\n" : "Already at schema ".\CajeerEngine\Storage\SiteState::SCHEMA.".\n"; break;
        case 'module':
            $action=$argv[2]??'list';
            if ($action==='list' && count($argv)===3) {
                $state=$app->load();
                foreach(ModuleConfig::DEFAULTS as $key=>$_) echo $key.': '.(ModuleConfig::enabled($state,$key)?'enabled':'disabled')."\n";
            } elseif (in_array($action,['enable','disable'],true) && count($argv)===4) {
                $app->module($argv[3],$action==='enable');
                echo $argv[3].': '.$action."d\n";
            } else throw new InvalidArgumentException('Usage: module list | module enable|disable <name>');
            break;
        case 'recovery':
            $operation=$argv[2] ?? '';
            $recovery=new RecoveryService($app);
            if ($operation==='issue' && count($argv)===3) {
                $token=$recovery->issue();
                echo "ONE-TIME RECOVERY TOKEN (expires in 10 minutes; save privately):\n".$token."\n";
            } elseif ($operation==='status' && count($argv)===3) {
                echo json_encode($recovery->status(),JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";
            } elseif ($operation==='cancel' && count($argv)===3) {
                $recovery->cancel(); echo "Recovery grant cancelled.\n";
            } elseif ($operation==='complete' && count($argv)===5) {
                $token=RecoveryService::readInput($app->root,$argv[3],128);
                $password=RecoveryService::readInput($app->root,$argv[4],128);
                $recovery->complete($token,$password);
                echo "Access recovered. All sessions revoked; sign in locally and rebind SkiF4er ID.\n";
            } else throw new InvalidArgumentException('Usage: recovery issue|status|cancel | recovery complete <absolute-private-token-file> <absolute-private-password-file>');
            break;
        case 'backup':
            $action=$argv[2]??'';
            $backup=$app->backups();
            if ($action==='create' && count($argv)===3) echo "Backup created: ".$backup->create()."\n";
            elseif ($action==='list' && count($argv)===3) {
                foreach ($backup->names() as $name) {
                    try {
                        $info=$backup->verify($name);
                        echo $name.' '.$info['reason'].' schema='.$info['schema']." verified\n";
                    } catch(Throwable $e) { echo $name." INVALID: ".$e->getMessage()."\n"; }
                }
            } elseif ($action==='verify' && count($argv)===4) {
                $backup->verify($argv[3]); echo "Backup verified: ".$argv[3]."\n";
            } elseif ($action==='restore' && count($argv)===4) {
                if (getenv('CAJEER_RESTORE_CONFIRM') !== $argv[3]) throw new InvalidArgumentException('Set CAJEER_RESTORE_CONFIRM to the backup file name. Stop web workers before restoring.');
                $rescue=$backup->restore($argv[3]);
                echo "Restored: ".$argv[3].($rescue!==''?' (previous state: '.$rescue.')':'')."\n";
            } else throw new InvalidArgumentException('Usage: backup create | backup list | backup verify <name> | backup restore <name>');
            break;
        default:
            echo "CajeerEngine Lite ".Lite::VERSION." (CajeerEngine core ".Lite::ENGINE_BASE_VERSION.")\n".
                 "php bin/cajeer install [url] [name]\nphp bin/cajeer doctor\nphp bin/cajeer monitor check|status [--minutes=60] [--verify-backup]\nphp bin/cajeer security audit [--json]\nphp bin/cajeer migrate\nphp bin/cajeer compatibility check [--json] | compatibility migration preview|apply\n".
                 "php bin/cajeer update monitor status|monitor check|snapshots status|snapshots prune|trust status|status|control status|control work|scheduler status|scheduler tick|maintenance plan|maintenance recover|maintenance verify|auto status|auto check|auto verify|auto run|verify <package>|install <package>|recover|rollback <id>|package <candidate-dir> <output>\n".
                 "php bin/cajeer ai status | ai acceptance [--json] [--live] | ai release-check [--json] [--live] [--paid]\nphp bin/cajeer support check [--json]\n".
                 "php bin/cajeer module list|enable|disable [name]\n".
                 "php bin/cajeer backup create|list|verify|restore [filename]\n".
                 "php bin/cajeer operations check | recover | audit | repair-orphans | backup create|list|verify|restore | export <absolute-file> | import <file> | cache clear | prune <keep>\n".
                 "php bin/cajeer recovery issue|status|cancel|complete <token-file> <password-file>\n".
                 "php bin/cajeer integrations check [--json]\n".
                 "php bin/cajeer release check [--json] | release stable-check [--json] [--live]\nphp bin/cajeer release production-check|sign-off --artifacts=DIR [--live] [--evidence=DIR] [--provider=NAME]\nphp bin/cajeer release rc-check [--live] [--provider=oidc|openai|ga4|metrica|matomo|clarity|gsc|yandex_webmaster] [--paid]\nphp bin/cajeer auth check [--json]\n".
                 "php bin/cajeer auth release-check [--json] [--live]\n".
                 "php bin/cajeer analytics refresh|status [--days=7]\n";
    }
} catch(Throwable $e) { fwrite(STDERR,$e->getMessage()."\n"); exit(1); }
